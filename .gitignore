# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI assistant tooling — machine-local settings, not project configuration
.claude/

# Environment — real credentials. Copy .env.example to .env instead.
# .env.example is the committed template and carries placeholders only, so it
# is excluded from the catch-all below rather than left to the order of rules.
.env*
!.env.example
# Emulator-only demo values (no secrets), for `npm run dev:emulators`.
!.env.emulators

# Vercel CLI — project link and the OIDC token it refreshes. Machine-local.
.vercel

# Local design tooling. Playwright screenshots and the design hook's cache are
# machine-local; the approved comps and surface briefs under .impeccable/ are
# the design record and are committed.
.playwright-mcp/
.impeccable/hook.cache.json

# Firebase — build output, the CLI's deploy cache and exported emulator data
# are machine-local. Service account keys must never be committed; these
# patterns catch the file names the console and gcloud give them.
functions/lib/
.firebase/
emulator-data/
*-firebase-adminsdk-*.json
service-account*.json
serviceAccount*.json
