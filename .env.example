# Supabase project configuration — copy to .env and fill in to activate
# real Supabase Auth (and, in later sprints, database + storage).
# Without these, the app runs against the built-in development auth driver.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Firebase (egso-b2c0a) — the backend replacing Supabase, wired in module by
# module. Copy each value from Firebase console → project "egso" →
# Project settings → Your apps → Web app → SDK setup and configuration.
# They are public client identifiers, not secrets; security comes from
# firestore.rules and storage.rules. Never put a service account key here.
#
# The app refuses any project ID other than egso-b2c0a or an emulator-only
# demo-* ID, and refuses alaminos-municipality and egso-2k26 by name.
#
# Local development against the Emulator Suite (npm run emulators):
#   VITE_FIREBASE_PROJECT_ID=demo-egso-prims
#   VITE_FIREBASE_USE_EMULATORS=true
#   (the other values may be any non-empty placeholder)
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain
VITE_FIREBASE_PROJECT_ID=egso-b2c0a
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_USE_EMULATORS=false
# App Check (reCAPTCHA Enterprise site key) — set once the web app is
# registered for App Check in the console; leave empty until then.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Which backend the app uses: "supabase" (the default, the current live
# site) or "firebase". With "firebase", every module — the public portal,
# procurement, inventory, utilities, violations, Records Management,
# notifications, the audit trail and Settings — reads and writes Firestore,
# and staff sign in with Firebase Authentication (accounts and roles come
# from the setup script in functions/setup). Each module keeps its Supabase
# version (api.supabase.ts) as the fallback; the record policies that need
# Cloud Functions (voids, archives, server numbering) work on Firebase only.
VITE_DATA_BACKEND=supabase
