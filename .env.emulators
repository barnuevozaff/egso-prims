# The app against the local Firebase Emulator Suite: `npm run dev:emulators`
# (Vite mode "emulators"), with `npm run emulators` running alongside.
# Offline demo project only — these values reach nothing outside this PC and
# are not secrets. The app refuses any project other than demo-* (with the
# emulators on) or egso-b2c0a.
VITE_DATA_BACKEND=firebase
VITE_FIREBASE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-egso-prims
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-egso-prims.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-egso-prims.appspot.com
VITE_FIREBASE_APP_ID=demo-app
